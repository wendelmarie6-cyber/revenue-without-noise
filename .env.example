# Database connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Stripe, TEST MODE ONLY (sk_test_ / pk_test_). Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Not used yet (hosted Checkout needs no browser key); kept for a later embedded form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally from `stripe listen`,
# deployed from Dashboard > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=

# Vercel Blob storage for uploaded media (product photos). Set automatically in
# Vercel when a Blob store is connected to the project; leave empty locally to
# store uploads on the local disk.
BLOB_READ_WRITE_TOKEN=
